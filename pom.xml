<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>org.temporedata</groupId>
    <artifactId>temporedata</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>temporedata</name>
    <description>轻舟数据云 - 统一的数据开发、资产、服务与治理平台</description>

   <modules>
        <module>temporedata-bom</module>
        <module>temporedata-common</module>
        <module>temporedata-api</module>
        <module>temporedata-support</module>
        <module>temporedata-security</module>
        <module>temporedata-service</module>
        <module>temporedata-datasource-plugin</module>
        <module>temporedata-server</module>
    </modules>

    <properties>
        <java.version>11</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>aliyun</id>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.projectlombok</groupId>
                    <artifactId>lombok-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!--
      P3-13 漏洞治理与测试体系 - 安全分析 profile（CI 侧 SCA/SBOM/SAST + 测试分级门禁）。
      默认关闭（activeByDefault=false），本地离线 `mvn package` 不受影响；CI 用 `mvn -Psecurity verify` 触发。
    -->
    <profiles>
        <profile>
            <id>security</id>
            <build>
                <plugins>
                    <!-- SAST: SpotBugs 静态分析，High/Blocker 即失败 -->
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>4.8.6.0</version>
                        <configuration>
                            <effort>Max</effort>
                            <threshold>High</threshold>
                            <failOnError>true</failOnError>
                            <failOnBug>true</failOnBug>
                            <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
                        </configuration>
                        <executions>
                            <execution>
                                <id>spotbugs</id>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- SCA: OWASP Dependency-Check 依赖漏洞扫描，CVSS>=7 即失败 -->
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>8.4.3</version>
                        <configuration>
                            <format>SARIF</format>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <skipTestScope>true</skipTestScope>
                            <failOnError>false</failOnError>
                        </configuration>
                        <executions>
                            <execution>
                                <id>dependency-check</id>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- SBOM: CycloneDX 物料清单 -->
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>2.7.11</version>
                        <executions>
                            <execution>
                                <id>cyclebom</id>
                                <goals>
                                    <goal>makeAggregateBom</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>